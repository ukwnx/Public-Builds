-- AUTOMATED NETWORK KEY CODES (Pulls straight from your GitHub Pages file)
local function generateSecretDailyKey()
    local success, result = pcall(function()
        -- ⚠️ REPLACE "YOUR_USERNAME" WITH YOUR ACTUAL GITHUB NAME BELOW!
        return game:HttpGet("https://ukwnx.github.io/roblox-key-hub/key1.txt")
    end)
    
    if success then
        -- Automatically trims out any hidden web spacing or trailing characters
        local cleanKey = string.gsub(result, "[%s\r\n]", "")
        return cleanKey
    else
        warn("[SERVER ERROR] Failed to fetch dynamic key from GitHub Pages.")
        return nil
    end
end

local function tapKey(key)
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    task.wait(0.01)
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

